#!/usr/bin/env bash
# ==============================================================================
# Arch Linux Deployment Configuration
# Adaptive Hardware Profiling & Modular Configuration Suite
# ==============================================================================

# ------------------------------------------------------------------------------
# Interactive Wizard & Automation Mode
# ------------------------------------------------------------------------------
# Set to "true" to display interactive selection menus during execution.
# When running non-interactively or in CI, set to "false" to use variables below.
INTERACTIVE="${INTERACTIVE:-true}"

# ------------------------------------------------------------------------------
# Automatic Hardware Specification Detection
# ------------------------------------------------------------------------------
# Automatically probe CPU vendor/model, microcode, RAM, storage drives,
# GPU topology, chassis type, and virtualization before installation.
AUTO_DETECT_HARDWARE="${AUTO_DETECT_HARDWARE:-true}"

# ------------------------------------------------------------------------------
# Storage Target & Disk Layout
# ------------------------------------------------------------------------------
# Target Disk Layout:
# - "single" : Install entirely onto a single disk (DISK1). Preserves all other drives.
# - "all"    : Use and partition all detected/configured drives (DISK1 + DISK2 / pools).
DISK_LAYOUT="${DISK_LAYOUT:-single}"

# Primary Storage Drive (Drive 1): Contains 1GB EFI System Partition and root filesystem
DISK1="${DISK1:-/dev/sda}"

# Secondary Storage Drive (Drive 2): Used when DISK_LAYOUT="all"
DISK2="${DISK2:-/dev/sdb}"

# ------------------------------------------------------------------------------
# Partition Scheme & Filesystem Selection
# ------------------------------------------------------------------------------
# Root Filesystem Choice:
# - "btrfs" : Advanced subvolumes (@, @home, @snapshots, @var_log, @pkg), zstd compression & snapshots
# - "ext4"  : Classic, rock-solid standard Linux journaling filesystem
# - "xfs"   : High-performance enterprise 64-bit journaling filesystem
# - "f2fs"  : Flash-Friendly File System optimized for SSDs and NVMe drives
FILESYSTEM="${FILESYSTEM:-btrfs}"
FS_TYPE="${FS_TYPE:-${FILESYSTEM}}"

# Btrfs Multi-Device Mode (used when FILESYSTEM="btrfs" and DISK_LAYOUT="all"):
# - "raid0"    : Striped data pool across drives for maximum throughput
# - "single"   : Linear concatenation spanning drives
# - "separate" : Drive 2 formatted independently and mounted at SECONDARY_MOUNT
BTRFS_MODE="${BTRFS_MODE:-raid0}"

# Secondary mount point for standalone secondary drives (ext4/xfs/f2fs or Btrfs separate)
SECONDARY_MOUNT="${SECONDARY_MOUNT:-/data}"

# Mount Options per Filesystem
BTRFS_MOUNT_OPTS="noatime,compress=zstd:3,space_cache=v2,discard=async"
EXT4_MOUNT_OPTS="noatime,errors=remount-ro"
XFS_MOUNT_OPTS="noatime"
F2FS_MOUNT_OPTS="noatime"

# ------------------------------------------------------------------------------
# System Localization & Identification
# ------------------------------------------------------------------------------
TIMEZONE="${TIMEZONE:-UTC}"
LOCALE="${LOCALE:-en_US.UTF-8}"
KEYMAP="${KEYMAP:-us}"
HOSTNAME="${HOSTNAME:-arch-workstation}"

# ------------------------------------------------------------------------------
# User Provisioning
# ------------------------------------------------------------------------------
USERNAME="${USERNAME:-archie}"
DEFAULT_SHELL="${DEFAULT_SHELL:-fish}"
USER_PASSWORD="${USER_PASSWORD:-}"
ROOT_PASSWORD="${ROOT_PASSWORD:-}"

# ------------------------------------------------------------------------------
# Desktop Environment & Display Manager Selection
# ------------------------------------------------------------------------------
# Desktop Environment / Window Manager:
# - "bspwm" : Minimalist tiling window manager + LightDM display manager + Polybar + Rofi + Dunst
# - "gnome" : Full modern GNOME Desktop Environment + GDM display manager
DESKTOP_ENV="${DESKTOP_ENV:-bspwm}"
WM="${WM:-${DESKTOP_ENV}}"

# Display Manager:
# - "lightdm" : LightDM Display Manager with GTK Greeter (auto-selected for bspwm)
# - "gdm"     : GNOME Display Manager (auto-selected for gnome)
# If left empty, DISPLAY_MANAGER is dynamically selected based on DESKTOP_ENV.
DISPLAY_MANAGER="${DISPLAY_MANAGER:-lightdm}"

# Terminal Emulator: "kitty" or "alacritty"
TERMINAL="${TERMINAL:-kitty}"

# Default Text Editor: "neovim" (CLI) alongside "mousepad" (GTK GUI)
TEXT_EDITOR="${TEXT_EDITOR:-neovim}"

# Default Web Browser: "firefox"
BROWSER="${BROWSER:-firefox}"

# Power & Thermal Management: "tlp"
POWER_MANAGER="${POWER_MANAGER:-tlp}"

# Dotfiles & Community Ricing (for BSPWM)
AUTO_INSTALL_DOTFILES="${AUTO_INSTALL_DOTFILES:-true}"
DOTFILES_REPO_URL="${DOTFILES_REPO_URL:-https://github.com/theduckchannel/bspwm-install.git}"

# ------------------------------------------------------------------------------
# Hardware & Kernel Parameters
# ------------------------------------------------------------------------------
ENABLE_AMDGPU_SI="true"
ZRAM_FRACTION="0.5"
ZRAM_ALGORITHM="zstd"

# ------------------------------------------------------------------------------
# Package Repositories & AUR Helper
# ------------------------------------------------------------------------------
ENABLE_MULTILIB="${ENABLE_MULTILIB:-true}"
ENABLE_CHAOTIC_AUR="${ENABLE_CHAOTIC_AUR:-true}"
INSTALL_PARU="${INSTALL_PARU:-true}"
INSTALL_ANTIGRAVITY_CLI="${INSTALL_ANTIGRAVITY_CLI:-true}"

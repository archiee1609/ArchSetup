#!/usr/bin/env bash
# ==============================================================================
# Arch Linux Deployment Configuration for Dual-SSD Laptop
# Target: Intel Core i5-8250U (Kaby Lake-R) + AMD Radeon R5 M330 (Oland)
# ==============================================================================

# ------------------------------------------------------------------------------
# Automatic Hardware Specification Detection
# ------------------------------------------------------------------------------
# Set to "true" to automatically recognize CPU vendor/model, microcode, RAM,
# storage disks, GPU topology, chassis type, and virtualization before installing.
# Explicit settings below will override auto-detection if manually specified.
AUTO_DETECT_HARDWARE="${AUTO_DETECT_HARDWARE:-true}"

# ------------------------------------------------------------------------------
# Storage & Disks
# ------------------------------------------------------------------------------
# Primary SSD (Drive 1): Will contain 1GB EFI System Partition and root Btrfs partition
DISK1="${DISK1:-/dev/sda}"

# Secondary SSD (Drive 2): Spanned Btrfs pool or dedicated secondary drive
DISK2="${DISK2:-/dev/sdb}"

# Btrfs Multi-Device Mode:
# - "raid0"    : Striped data pool across both SSDs for maximum throughput & 240GB total.
#                Metadata set to raid1 for fault tolerance or raid0 for raw speed.
# - "single"   : Linear concatenation spanning both SSDs.
# - "separate" : Drive 2 formatted as a standalone Btrfs filesystem mounted at /data.
BTRFS_MODE="${BTRFS_MODE:-raid0}"

# Secondary mount point if BTRFS_MODE="separate"
SECONDARY_MOUNT="/data"

# Standard Btrfs mount options requested
BTRFS_MOUNT_OPTS="noatime,compress=zstd:3,space_cache=v2,discard=async"

# ------------------------------------------------------------------------------
# System Localization & Identification
# ------------------------------------------------------------------------------
TIMEZONE="${TIMEZONE:-UTC}"
LOCALE="${LOCALE:-en_US.UTF-8}"
KEYMAP="${KEYMAP:-us}"
HOSTNAME="${HOSTNAME:-arch-workstation}"

# ------------------------------------------------------------------------------
# User Provisioning
# ------------------------------------------------------------------------------
# Non-root administrative user
USERNAME="${USERNAME:-archie}"

# Default Login & Interactive Shell: "fish" or "bash"
DEFAULT_SHELL="${DEFAULT_SHELL:-fish}"

# Leave passwords empty to be prompted interactively during execution
USER_PASSWORD="${USER_PASSWORD:-}"
ROOT_PASSWORD="${ROOT_PASSWORD:-}"

# ------------------------------------------------------------------------------
# Community Dotfiles & Automated Ricing
# ------------------------------------------------------------------------------
# Automatically fetch and deploy curated community dotfiles (The Duck Channel bspwm rice)
AUTO_INSTALL_DOTFILES="${AUTO_INSTALL_DOTFILES:-true}"
DOTFILES_REPO_URL="${DOTFILES_REPO_URL:-https://github.com/theduckchannel/bspwm-install.git}"

# ------------------------------------------------------------------------------
# Window Manager & Userland Stack
# ------------------------------------------------------------------------------
# Options: "bspwm"
WM="${WM:-bspwm}"

# Default Terminal Emulator: "kitty" or "alacritty"
TERMINAL="${TERMINAL:-kitty}"

# Display Manager: "lightdm" (LightDM Display Manager with GTK Greeter) or "none" (xinit)
DISPLAY_MANAGER="${DISPLAY_MANAGER:-lightdm}"

# Default Text Editor: "neovim" (CLI) alongside "mousepad" (GTK GUI)
TEXT_EDITOR="${TEXT_EDITOR:-neovim}"

# Default Web Browser: "firefox"
BROWSER="${BROWSER:-firefox}"

# Power & Thermal Management: "tlp" (tuned for i5-8250U 15W TDP)
POWER_MANAGER="${POWER_MANAGER:-tlp}"

# ------------------------------------------------------------------------------
# Hardware & Kernel Parameters
# ------------------------------------------------------------------------------
# Intel i5-8250U UHD 620 + AMD Radeon R5 M330 (Oland / GCN 1.0 Southern Islands)
ENABLE_AMDGPU_SI="true"

# ZRAM Memory Configuration
ZRAM_FRACTION="0.5"
ZRAM_ALGORITHM="zstd"

# ------------------------------------------------------------------------------
# Package Repositories & AUR Helper
# ------------------------------------------------------------------------------
# Enable Multilib (32-bit software and gaming support, e.g. Steam, Wine)
ENABLE_MULTILIB="${ENABLE_MULTILIB:-true}"

# Enable Chaotic-AUR (Prebuilt binary package repository for AUR software)
ENABLE_CHAOTIC_AUR="${ENABLE_CHAOTIC_AUR:-true}"

# Install Paru (Feature-packed AUR helper and pacman wrapper)
INSTALL_PARU="${INSTALL_PARU:-true}"

# Install Antigravity CLI (Google Antigravity TUI agent orchestration platform)
INSTALL_ANTIGRAVITY_CLI="${INSTALL_ANTIGRAVITY_CLI:-true}"

#!/bin/sh

LOCK_CMD="i3lock"
if command -v i3lock-color >/dev/null 2>&1; then
    LOCK_CMD="i3lock-color"
fi

if ! command -v "$LOCK_CMD" >/dev/null 2>&1; then
    exit 0
fi

if "$LOCK_CMD" --help 2>&1 | grep -q "insidever-color"; then
    BLANK='#00000000'
    CLEAR='#ffffff22'
    DEFAULT='#ff00ffcc'
    TEXT='#ee00eeee'
    WRONG='#880000bb'
    VERIFYING='#bb00bbbb'

    "$LOCK_CMD" \
    --insidever-color=$CLEAR     \
    --ringver-color=$VERIFYING   \
    \
    --insidewrong-color=$CLEAR   \
    --ringwrong-color=$WRONG     \
    \
    --inside-color=$BLANK        \
    --ring-color=$DEFAULT        \
    --line-color=$BLANK          \
    --separator-color=$DEFAULT   \
    \
    --verif-color=$TEXT          \
    --wrong-color=$TEXT          \
    --time-color=$TEXT           \
    --date-color=$TEXT           \
    --layout-color=$TEXT         \
    --keyhl-color=$WRONG         \
    --bshl-color=$WRONG          \
    \
    --screen 1                   \
    --blur 5                     \
    --clock                      \
    --indicator                  \
    --time-str="%H:%M:%S"        \
    --date-str="%A, %m %Y"       \
    --keylayout 1
else
    "$LOCK_CMD" -c 2E3440
fi

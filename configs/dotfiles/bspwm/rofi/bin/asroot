#!/bin/bash

DIR="$HOME/.config/bspwm"

rofi_command="rofi -theme $DIR/rofi/themes/asroot.rasi"

# Apps
terminal=" Terminal"
files=" Thunar"
editor=" Mousepad"
clifm=" File Manager (CLI)"
lpad=" Text Editor"
vim=" Neovim"

# Variable passed to rofi
options="$terminal\n$files\n$editor\n$clifm\n$lpad\n$vim"

# Functions

chosen="$(echo -e "$options" | $rofi_command -p "Run as root(#)" -dmenu -selected-row 0)"
case $chosen in
    $terminal)
        apps_as_root 'bspterm -f'
        ;;
    $files)
        apps_as_root 'thunar'
        ;;
    $editor)
        apps_as_root 'mousepad'
        ;;
    $clifm)
        apps_as_root 'bspterm -f'
        ;;
    $lpad)
        apps_as_root 'mousepad'
        ;;
    $vim)
        apps_as_root 'bspterm -f -e nvim'
        ;;
esac



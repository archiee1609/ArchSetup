#!/usr/bin/env bash
# ==============================================================================
# BSPWM Configuration - The Duck Channel Aesthetic Rice
# Customized with Focus Enforcement & Robust Fallbacks
# ==============================================================================

## Environment Paths
export PATH="${PATH}:$HOME/.config/bspwm/bin"

## Get colors from .Xresources ------------------------------------------------
if [[ -f "$HOME/.Xresources" ]]; then
    xrdb "$HOME/.Xresources" 2>/dev/null || true
fi

getcolors () {
	FOREGROUND="$(xrdb -query 2>/dev/null | grep 'foreground:' | awk '{print $NF}')"
	BACKGROUND="$(xrdb -query 2>/dev/null | grep 'background:' | awk '{print $NF}')"
	BLACK="$(xrdb -query 2>/dev/null | grep 'color0:' | awk '{print $NF}')"
	RED="$(xrdb -query 2>/dev/null | grep 'color1:' | awk '{print $NF}')"
	GREEN="$(xrdb -query 2>/dev/null | grep 'color2:' | awk '{print $NF}')"
	YELLOW="$(xrdb -query 2>/dev/null | grep 'color3:' | awk '{print $NF}')"
	BLUE="$(xrdb -query 2>/dev/null | grep 'color4:' | awk '{print $NF}')"
	MAGENTA="$(xrdb -query 2>/dev/null | grep 'color5:' | awk '{print $NF}')"
	CYAN="$(xrdb -query 2>/dev/null | grep 'color6:' | awk '{print $NF}')"
	WHITE="$(xrdb -query 2>/dev/null | grep 'color7:' | awk '{print $NF}')"

	# Fallbacks (Nord)
	FOREGROUND="${FOREGROUND:-#D8DEE9}"
	BACKGROUND="${BACKGROUND:-#2E3440}"
	BLACK="${BLACK:-#3B4252}"
	RED="${RED:-#BF616A}"
	GREEN="${GREEN:-#A3BE8C}"
	YELLOW="${YELLOW:-#EBCB8B}"
	BLUE="${BLUE:-#81A1C1}"
	MAGENTA="${MAGENTA:-#B48EAD}"
	CYAN="${CYAN:-#88C0D0}"
	WHITE="${WHITE:-#E5E9F0}"
}
getcolors

## Desktop Workspaces ---------------------------------------------------------
bspc monitor -d 'I' 'II' 'III' 'IV' 'V' 'VI' 'VII' 'VIII'

## Window Manager Styling ------------------------------------------------------
bspc config border_width         1
bspc config window_gap           10
bspc config split_ratio          0.50

bspc config focused_border_color   "$BLUE"
bspc config normal_border_color    "$BACKGROUND"
bspc config active_border_color    "$MAGENTA"
bspc config presel_feedback_color  "$GREEN"

bspc config borderless_monocle     true
bspc config gapless_monocle        true
bspc config paddingless_monocle    true
bspc config single_monocle         false
bspc config focus_follows_pointer  true

## Window Rules (Focus Enforcement & Floating Rules) --------------------------
bspc rule -r *:*

# Critical: Guarantee Rofi receives focus immediately on launch
bspc rule -a Rofi state=floating focus=on
bspc rule -a rofi state=floating focus=on
bspc rule -a Pavucontrol state=floating focus=on
bspc rule -a Gpick state=floating
bspc rule -a alacritty-float state=floating focus=on
bspc rule -a kitty-float state=floating focus=on
bspc rule -a Viewnior state=floating focus=on
bspc rule -a Feh state=floating focus=on
bspc rule -a Lxappearance state=floating

## Autostart Subsystems & Daemons ---------------------------------------------

# Terminate existing instances
killall -q sxhkd xsettingsd dunst xfce4-power-manager polybar picom || true

# Notification daemon
dunst \
  -geom "280x50-10+38" -frame_width "1" -font "JetBrainsMono Nerd Font 9" \
  -lb "$BACKGROUND" -lf "$FOREGROUND" -lfr "$BLUE" \
  -nb "$BACKGROUND" -nf "$FOREGROUND" -nfr "$BLUE" \
  -cb "$BACKGROUND" -cf "$RED" -cfr "$RED" &

# XSettings Daemon for GTK theme propagation
command -v xsettingsd >/dev/null 2>&1 && xsettingsd &

# Polkit Authentication Agent
if ! pgrep -x xfce-polkit >/dev/null 2>&1; then
    if [[ -x /usr/lib/xfce-polkit/xfce-polkit ]]; then
        /usr/lib/xfce-polkit/xfce-polkit &
    elif [[ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ]]; then
        /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
    fi
fi

# Keybinding daemon
pgrep -x sxhkd >/dev/null 2>&1 || sxhkd &

# Super key menu binding (if ksuperkey is available)
if command -v ksuperkey >/dev/null 2>&1; then
    ksuperkey -e 'Super_L=Alt_L|F1' &
    ksuperkey -e 'Super_R=Alt_L|F1' &
fi

# Power management daemon
command -v xfce4-power-manager >/dev/null 2>&1 && xfce4-power-manager &

# Fix X11 standard cursor
xsetroot -cursor_name left_ptr &

# Restore active wallpaper
if [[ -f "$HOME/.fehbg" ]]; then
    bash "$HOME/.fehbg" &
fi

# Background music daemon (optional)
if command -v mpd >/dev/null 2>&1; then
    mpd 2>/dev/null &
fi

# Launch rice modules (colors, compositor, status bar, network applet)
bspcolors
bspcomp
bspbar
bspfloat &

if command -v nm-applet >/dev/null 2>&1; then
    nm-applet &
fi

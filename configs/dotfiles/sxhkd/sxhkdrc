# ==============================================================================
# SXHKD Keybindings for BSPWM (The Duck Channel Rice + Enhancements)
# ==============================================================================

##---------- Terminal Emulators ----------##

# Standard Terminal
super + Return
	bspterm

# Floating Terminal
super + shift + Return
	bspterm -f

##---------- Application Launcher & Rofi Menus ----------##

# Application Launcher (Supports Super+d and Alt+F1)
super + d
	sh ~/.config/bspwm/rofi/bin/launcher

alt + F1
	sh ~/.config/bspwm/rofi/bin/launcher

# Run Dialog (rofi runner)
super + shift + d
	rofi -no-lazy-grab -show run

# Network Management Menu
super + n
	sh ~/.config/bspwm/rofi/bin/network

# Rofi Menus (Windows, MPD, Power Menu, Root Apps)
super + {w,m,x,r}
	sh ~/.config/bspwm/rofi/bin/{windows,mpd,powermenu,asroot}

# Quick Rice Menus (Screenshots, Network, Theme Switcher)
ctrl + alt + {s,n,t}
	sh ~/.config/bspwm/rofi/bin/{screenshot,network,themes}

##---------- Applications ----------##

# GUI File Manager (Thunar)
super + t
	thunar

# Web Browser (Firefox)
super + b
	firefox

##---------- System Hardware Controls ----------##

# Screenshots
Print
	scrot 'Screenshot_%Y-%m-%d-%S_$wx$h.png' -e 'mkdir -p ~/Pictures && mv $f ~/Pictures/'

alt + Print
	scrot -d 5 'Screenshot_%Y-%m-%d-%S_$wx$h.png' -e 'mkdir -p ~/Pictures && mv $f ~/Pictures/'

# Brightness Controls (brightnessctl)
XF86MonBrightnessUp
	brightnessctl set +5%

XF86MonBrightnessDown
	brightnessctl set 5%-

# Volume Controls (WirePlumber / PipeWire / ALSA)
XF86AudioRaiseVolume
	wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ 2>/dev/null || amixer set Master 5%+

XF86AudioLowerVolume
	wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- 2>/dev/null || amixer set Master 5%-

XF86AudioMute
	wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle 2>/dev/null || amixer set Master toggle

# Music playback controls (MPD / MPC)
XF86Audio{Next,Prev,Play,Stop}
	mpc {next,prev,toggle,stop} 2>/dev/null

##---------- BSPWM Window Controls ----------##

# Lock Screen
ctrl + alt + l
	bsplock

# Reload Keybindings Daemon
super + Escape
	pkill -USR1 -x sxhkd

# Quit / Restart BSPWM
super + control + q
	bspc quit

super + control + r
	bspc wm -r

ctrl + alt + {q,r}
	bspc {quit,wm -r}

# Close Focused Window
super + q
	bspc node -c

# Force Kill Window
ctrl + alt + Escape
	xkill

# Fullscreen / Monocle toggle
super + f
	bspc desktop -l next

# Window split directions
super + {h,v}
	bspc node -p {east,south}

super + ctrl + space
	bspc node -p cancel

# Preselect Split Ratio
super + ctrl + {1-9}
	bspc node -o 0.{1-9}

# Toggle Floating & Tiled
super + space
	bspc node -t "~"{floating,tiled}

# Pseudo Tiled & Tiled Mode
super + {p,shift + t}
	bspc node -t {pseudo_tiled,tiled}

# Window Flags (Marked, Locked, Sticky, Private)
super + ctrl + {m,x,y,z}
	bspc node -g {marked,locked,sticky,private}

# Directional Window Focus
super + {Left,Down,Up,Right}
	bspc node -f {west,south,north,east}

super + {h,j,k,l}
	bspc node -f {west,south,north,east}

# Swap Windows
super + shift + {Left,Down,Up,Right}
	bspc node -s {west,south,north,east}

super + shift + {h,j,k,l}
	bspc node -s {west,south,north,east}

# Cycle Window Focus
alt + Tab
	bspc node -f next.local

alt + shift + Tab
	bspc node -f prev.local

# Switch Workspaces
ctrl + alt + {Left,Right}
	bspc desktop -f {prev.local,next.local}

# Switch to Specific Workspace (1-8)
super + {1-8}
	bspc desktop -f '^{1-8}'

# Move Focused Window to Workspace (1-8)
super + shift + {1-8}
	bspc node -d '^{1-8}' --follow

# Expanding Windows
super + control + {Left,Right,Up,Down}
	bspc node -z {left -20 0,right 20 0,top 0 -20,bottom 0 20}

# Shrinking Windows
super + alt + {Left,Right,Up,Down}
	bspc node -z {left 20 0,right -20 0,top 0 20,bottom 0 -20}

# Move Floating Windows
alt + shift + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}

# Hide / Unhide Window
super + shift + i
	winmask
